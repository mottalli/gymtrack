{
  "name": "gymtrack-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "test": "vitest --project storybook run",
    "test:e2e": "node tests/smoke.mjs",
    "test:stepper": "node tests/number-stepper.mjs",
    "test:exercises": "node --experimental-strip-types --test tests/exercise-motions.test.mjs && node tests/exercise-previews.mjs",
    "preview": "vite preview",
    "storybook": "storybook dev -p 6006 --host 127.0.0.1 --no-open",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.6.0",
    "@eslint/js": "^10.0.1",
    "@storybook/addon-a11y": "^10.6.6",
    "@storybook/addon-docs": "^10.6.6",
    "@storybook/addon-mcp": "^10.6.6",
    "@storybook/addon-vitest": "^10.6.6",
    "@storybook/react-vite": "^10.6.6",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/browser-playwright": "^5.1.0",
    "@vitest/coverage-v8": "^5.1.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "eslint-plugin-storybook": "^10.6.6",
    "globals": "^17.13.0",
    "msw": "^3.0.4",
    "msw-storybook-addon": "^3.0.3",
    "playwright": "^1.65.0",
    "storybook": "^10.6.6",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^7.3.8",
    "vitest": "^5.1.0"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
